# --- Database ---
# Local (Docker): both point at the same instance.
# Vercel + Neon integration: DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED
#   (direct, for migrations) are injected automatically — the names match.
# Standalone Neon: set DATABASE_URL to the "-pooler" string and
#   DATABASE_URL_UNPOOLED to the direct one.
DATABASE_URL="postgresql://jhc:jhc@localhost:5432/jhc?schema=public"
DATABASE_URL_UNPOOLED="postgresql://jhc:jhc@localhost:5432/jhc?schema=public"

# --- Auth (NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only this email may sign in (single-user app). Leave blank to allow any Google account.
ALLOWED_EMAIL="shagun0915@gmail.com"
# Set only if NextAuth can't infer the deployed URL (Vercel infers it automatically).
# AUTH_URL="https://<your-domain>"

# --- LLM (any OpenAI-compatible endpoint) ---
# Default: OpenAI (paid, cheap — gpt-4o-mini is fractions of a cent per call).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBED_MODEL="text-embedding-3-small"
# OPENAI_BASE_URL=""   # leave unset for OpenAI itself

# --- Free alternative: Google Gemini ---
# No credit card, no cost, no expiring trial. Get a key at
# https://aistudio.google.com/apikey — then set:
#   OPENAI_API_KEY="<your Gemini API key>"
#   OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
#   OPENAI_MODEL="gemini-3.6-flash"
#   OPENAI_EMBED_MODEL="gemini-embedding-001"
# Free-tier limits (~10 requests/min, 250/day) are far more than a personal
# tracker needs. Caveat: free-tier prompts may be used by Google for training —
# don't use it if your résumé/JD content needs to stay fully private (use a
# paid Gemini or OpenAI key instead, same env vars either way).
#
# Gemini's "thinking" models spend part of max_tokens on hidden reasoning
# before writing the JSON — with OPENAI_BASE_URL set to Gemini, the app
# automatically requests minimal reasoning to avoid truncated output. Override
# with OPENAI_REASONING_EFFORT ("none"|"minimal"|"low"|"medium"|"high") if needed.

# --- Gmail sync ---
# Requested Google scope for reading mail. Keep in sync with src/auth.ts.
GMAIL_SCOPE="https://www.googleapis.com/auth/gmail.readonly"
# Shared secret for the Vercel Cron job that runs inbox sync. Generate any random string.
CRON_SECRET=""
